# ═════ امضاگیر — تنظیمات استقرار VPS (فایل را به .env کپی کنید) ═════
# اسکریپت scripts/install-vps.sh همه‌ی اینها را خودش می‌سازد؛ فقط برای نصب دستی لازم است.

# دامنه‌ی ابر (رکورد A باید به IP سرور اشاره کند)
APP_DOMAIN=sign.example.com
# ایمیل Let's Encrypt (برای هشدار انقضای گواهی)
ACME_EMAIL=you@example.com
# آدرس عمومی کامل (دقیقاً همان دامنه، با https)
APP_URL=https://sign.example.com

# رمزها: با  openssl rand -hex 24  بسازید
DB_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
# کلید نصب: /install فقط با این کلید کار می‌کند (اگر خالی بگذارید، کلید تصادفی در storage/install-key.txt ساخته می‌شود)
INSTALL_KEY=

# ── لایسنس و به‌روزرسانی (از فروشنده دریافت می‌کنید) ──
LICENSE_SERVER_URL=https://license.emzagar.ir
# اجباری برای فعال‌سازی لایسنس و به‌روزرسانی (C-01: بدون این کلید همه‌چیز بسته می‌ماند، نه باز).
# کلید عمومی Ed25519 فروشنده از /platform/vendor؛ ترجیحاً هنگام build داخل بسته/ایمیج تعبیه شود.
LICENSE_PUBLIC_KEY=
# 1 = بدون لایسنس معتبر، «صدور قرارداد جدید» بسته می‌شود (امضای قراردادهای موجود همچنان کار می‌کند)
LICENSE_REQUIRED=0

# ── ایمیل (برای بازیابی رمز و اعلان‌ها) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── بک‌آپ کامل (CR-04) ──
# مسیر نسخه‌ها؛ باید «بیرون» از پوشه‌ی storage و ترجیحاً روی دیسک/volume دیگر باشد (Docker: volume جدای backups).
# BACKUP_DIR=/var/backups/emzagar
# مقصدهای آینه (چند مسیر با ویرگول): دیسک/NFS/mount دیگر یا سرور دیگر. هر نسخه همان لحظه کپی و در مقصد راستی‌آزمایی می‌شود.
# BACKUP_MIRROR_DIRS=/mnt/offsite-a,/mnt/offsite-b
# کلید عمومی بازیابی: از «/platform ← ساخت کلید بازیابی» یا `npm run backup -- keygen` ساخته می‌شود (فایل storage/backup-recovery.pub).
# با آن، SESSION_SECRET (کلید رمزگشایی KYC) «مهر‌شده» داخل هر بک‌آپ می‌رود؛ کلید خصوصی فقط نزد شماست.
# BACKUP_RECOVERY_PUBLIC_KEY=
