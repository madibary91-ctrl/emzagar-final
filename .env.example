# ═════════ نکته: با نصب‌کننده‌ی وب (/install) هیچ‌کدام از این‌ها دستی لازم نیست ═════════
# خریدار مبتدی فقط سایت را باز می‌کند و فرم نصب را پر می‌کند؛ آدرس دیتابیس و کلید امنیتی خودکار در storage/config.json ذخیره می‌شود.
# متغیرهای زیر فقط برای Docker و مدیران سرور هستند (اولویت با متغیر محیطی است):
# INSTALL_KEY=یک-رمز-دلخواه   ← (CR-03) نصب‌کننده «همیشه» کلید می‌خواهد. اگر این را نگذارید، کلید تصادفی در storage/install-key.txt و لاگ سرور ساخته می‌شود و پس از نصب حذف می‌شود.
# INSTALL_OPEN=1              ← فقط CI/آزمون محلی: انصراف صریح از کلید نصب (روی سرور عمومی هرگز)
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dbname
# کلید امضای نشست، کدهای OTP و رمزنگاری کلیدهای ذخیره‌شده (کلید AI، رمز SMTP …)
# در production اجباری است (حداقل ۱۶ نویسه‌ی تصادفی). با تغییر آن، کلیدهای رمزنگاری‌شده باید دوباره وارد شوند.
# SESSION_SECRET=
# آدرس عمومی سایت (مثلاً https://sign.example.com). در production حتماً تنظیم شود تا لینک‌های ایمیل (بازیابی رمز و …) از هدر Host ساخته نشوند.
APP_URL=
# کلید محافظ /api/cron/run (اختیاری؛ زمان‌بند داخلی بدون آن هم کار می‌کند)
CRON_SECRET=
# فاصله‌ی اجرای زمان‌بند داخلی بر حسب دقیقه (پیش‌فرض ۱۰)
CRON_INTERVAL_MINUTES=10

# ── هوش مصنوعی ──
# کاربران کلید خودشان را در «تنظیمات ← هوش مصنوعی» وارد می‌کنند (رمزنگاری‌شده در دیتابیس).
# مقادیر زیر اختیاری‌اند و فقط «پیش‌فرض پلتفرم» برای فضاهای کاری بدون کلید اختصاصی هستند.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o
# سهمیه‌ی تولید متن در ۲۴ ساعت برای هر فضای کاری
AI_DAILY_LIMIT=40

# ── مدیر کل پلتفرم و ایمیل سطح پلتفرم ──
# اولین کاربر ثبت‌نام‌شده روی دیتابیس خالی خودکار مدیر کل می‌شود. برای افزودن مدیران دیگر (جداشده با ویرگول):
PLATFORM_ADMIN_EMAILS=
# SMTP پلتفرم برای ایمیل تیکت‌ها (اختیاری؛ بدون آن فقط در صندوق ارتباطات ثبت می‌شود)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# فقط برای توسعه/دمو: ساخت کاربران نمایشی (admin@example.com / admin123) روی دیتابیس خالی. در production خاموش بماند.
SEED_DEMO=0
# فقط برای تست: نمایش کد OTP و لینک‌های بازیابی در پاسخ (وقتی پیامک/ایمیل واقعی تنظیم نشده). در production خاموش بماند.
ALLOW_DEV_OTP=0

# ── اتصال بدون تنظیم (Zero-Config) افزونه‌ی وردپرس ──
# حتماً در production تنظیم شود: آدرسی که داخل افزونه‌ی دانلودی نوشته می‌شود و ابر با آن به سایت‌ها پاسخ می‌دهد (APP_URL بالا).
# پیامک مدیریت‌شده‌ی پلتفرم (اختیاری): فضاهای کاری بدون پنل پیامک اختصاصی از آن استفاده می‌کنند تا کد امضا همان لحظه‌ی نصب کار کند.
# مقدار PLATFORM_SMS_PROVIDER: kavenegar | melipayamak  (بدون آن، کد تایید از طریق ایمیل ارسال می‌شود؛ SMTP_* بالا را تنظیم کنید)
PLATFORM_SMS_PROVIDER=
PLATFORM_KAVENEGAR_API_KEY=
PLATFORM_KAVENEGAR_TEMPLATE=verify
PLATFORM_MELIPAYAMAK_USERNAME=
PLATFORM_MELIPAYAMAK_PASSWORD=
PLATFORM_MELIPAYAMAK_FROM=
# سقف پیامک مدیریت‌شده در ۲۴ ساعت برای هر فضای کاری
PLATFORM_SMS_DAILY_LIMIT=100

# ── اشتراک و پرداخت (زرین‌پال) ──
# شناسه‌ی ۳۶ نویسه‌ای مرچنت. بدون آن، در محیط توسعه پرداخت «آزمایشی» فعال است و در production پرداخت غیرفعال می‌ماند.
ZARINPAL_MERCHANT_ID=
# برای تست روی sandbox.zarinpal.com مقدار 1 بگذارید
ZARINPAL_SANDBOX=0
# فقط برای دمو: اجازه‌ی پرداخت شبیه‌سازی‌شده در production (پیشنهاد نمی‌شود)
ALLOW_DEMO_PAYMENTS=0

# ── امنیت پراکسی ──
# تعداد پراکسی‌های مورد اعتماد پیش روی برنامه (nginx، Cloudflare …). برای تشخیص درست IP در محدودیت نرخ و شناسنامه‌ی دیجیتال.
# H-04: اگر برنامه مستقیم (بدون پراکسی) به اینترنت باز است مقدار 0 بگذارید یا این خط را کاملاً حذف کنید (حالت خودکار:
# اتصال مستقیم از IP عمومی ⇒ هدرهای forwarded جعلی نادیده گرفته می‌شود). IP هر کلاینت از «آدرس واقعی سوکت» خوانده می‌شود.
TRUSTED_PROXY_HOPS=1

# ── تأیید ایمیل، PDF سمت سرور، بک‌آپ (نسخه‌ی تجاری) ──
# تأیید ایمیل هنگام ثبت‌نام پیش‌فرض الزامی است (نیازمند SMTP). فقط برای نصب‌های شخصی بدون SMTP: REQUIRE_EMAIL_VERIFICATION=0
REQUIRE_EMAIL_VERIFICATION=1
# خاموش‌کردن فیلتر ایمیل‌های یک‌بارمصرف و بررسی MX دامنه (فقط برای آزمون)
SKIP_EMAIL_DOMAIN_CHECK=0
# پوشه‌ی قلم‌های PDF (پیش‌فرض: assets/fonts)
# PDF_FONT_DIR=
# بک‌آپ خودکار: دیتابیس + storage/signatures + storage/documents. پیش‌فرض: هر ۲۴ ساعت، نگهداری ۱۴ نسخه
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# مقصد بک‌آپ (پیشنهاد: دیسک یا مسیر همگام‌شده‌ی جدا از دیسک اصلی)
# BACKUP_DIR=/var/backups/emzagar

# ── شبیه‌ساز سرویس‌های بیرونی (فقط برای تست/توسعه؛ در production خالی بگذارید) ──
# اگر تنظیم شود، پرداخت (زرین‌پال)، پیامک (کاوه‌نگار/ملی‌پیامک) و هوش مصنوعی (GapGPT) به شبیه‌ساز می‌روند و هیچ هزینه یا درخواست واقعی ایجاد نمی‌شود.
# اجرا: npx tsx simulator/cli.ts   —   راهنما: docs/SIMULATOR-FA.md
# EXTERNAL_SIM_URL=http://127.0.0.1:4010
# آدرسی که مرورگر کاربر برای صفحه‌ی پرداخت شبیه‌ساز می‌بیند (فقط وقتی با آدرس بالا فرق دارد؛ مثلاً در docker)
# EXTERNAL_SIM_PUBLIC_URL=
# پذیرفتن شبیه‌ساز روی میزبان غیرمحلی (مثل سرویس docker). پیش‌فرض: فقط localhost و IP خصوصی
# EXTERNAL_SIM_ALLOW_REMOTE=0
# کوتاه‌کردن مهلت تماس‌های بیرونی فقط در حالت شبیه‌ساز (مثلاً 0.02 یعنی مهلت ۱۰ ثانیه ← ۰٫۲ ثانیه) تا آزمون «قطعی/کندی سرویس» سریع شود
# EXTERNAL_TIMEOUT_SCALE=0.02

# ── سرویس هوش مصنوعی پیش‌فرض پلتفرم (اختیاری؛ کاربران در تنظیمات سرویس و کلید خودشان را وارد می‌کنند) ──
# AI_PROVIDER=gapgpt   # gapgpt | openai | gemini | anthropic | openrouter | deepseek | groq | mistral | custom
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ── لایسنس و به‌روزرسانی (docs/COMMERCIAL-FA.md) ──
# سمت خریدار: نشانی سرور لایسنس فروشنده و کلید عمومی امضا (در بسته‌ی فروش تنظیم شود)
# LICENSE_SERVER_URL=https://license.emzagar.ir
# LICENSE_PUBLIC_KEY=        # C-01: بدون کلید عمومی معتبر، فعال‌سازی لایسنس و به‌روزرسانی «مسدود» است (fail-closed). ترجیحاً هنگام build تعبیه شود.
# LICENSE_REQUIRED=0        # 1 = بدون لایسنس معتبر، صدور قرارداد جدید بسته می‌شود
# EMZ_UPDATER_DISABLED=0    # 1 = غیرفعال‌کردن به‌روزرسانی از داخل پنل
# سمت فروشنده: فعال‌کردن سرور لایسنس و کلید خصوصی (اگر ندهید، خودکار ساخته و رمزنگاری می‌شود)
# LICENSE_SERVER_ENABLED=1
# LICENSE_PRIVATE_KEY=

# ═════════ درگاه‌های پرداخت (اختیاری؛ ترجیحاً از «مدیریت پلتفرم ← تجارت و درگاه‌ها» تنظیم کنید) ═════════
# ZARINPAL_MERCHANT_ID=   ZIBAL_MERCHANT=   IDPAY_API_KEY=   PAYIR_API_KEY=
# IDPAY_SANDBOX=1        ← حالت آزمایشی آیدی‌پی
# KYC_THRESHOLD_TOMAN=100000000   ← آستانه‌ی الزام احراز هویت (۰ = غیرفعال)

# ── بک‌آپ کامل (CR-04) ──
# مسیر نسخه‌ها؛ باید «بیرون» از پوشه‌ی storage و ترجیحاً روی دیسک/volume دیگر باشد (Docker: volume جدای backups).
# BACKUP_DIR=/var/backups/emzagar
# مقصدهای آینه (چند مسیر با ویرگول): دیسک/NFS/mount دیگر یا سرور دیگر. هر نسخه همان لحظه کپی و در مقصد راستی‌آزمایی می‌شود.
# BACKUP_MIRROR_DIRS=/mnt/offsite-a,/mnt/offsite-b
# کلید عمومی بازیابی: از «/platform ← ساخت کلید بازیابی» یا `npm run backup -- keygen` ساخته می‌شود (فایل storage/backup-recovery.pub).
# با آن، SESSION_SECRET (کلید رمزگشایی KYC) «مهر‌شده» داخل هر بک‌آپ می‌رود؛ کلید خصوصی فقط نزد شماست.
# BACKUP_RECOVERY_PUBLIC_KEY=

# ═════════ امنیت (سطح High) ═════════
# TRUSTED_HOSTS=sign.example.com,www.example.com
#   اگر APP_URL نگذاشته‌اید، فقط هدر Host/X-Forwarded-Host که دقیقاً در این فهرست باشد برای ساخت لینک‌ها پذیرفته می‌شود.
#   بدون APP_URL و بدون این فهرست، ایمیل‌های توکن‌دار (بازیابی رمز، تأیید ایمیل، دعوت) ارسال نمی‌شوند (بسته شکست می‌خورند).
# TRUSTED_PROXY_HOPS: 0 = هیچ پراکسی مورد اعتماد نیست (X-Forwarded-For نادیده گرفته می‌شود)، 1 = یک پراکسی (Caddy/Nginx).
#   مقدار نامعتبر = ۰ (بسته). H-04: با ۰، IP همان آدرس واقعی سوکت است (نه «unknown»)؛ فقط اگر آدرس سوکت هم در دسترس نباشد
#   «unknown» می‌شود و سطل مشترک آن سقف چندبرابر دارد تا ورود همه قفل نشود.
# ALLOW_SANDBOX_CONNECT=1  ← فقط توسعه: اتصال سایت محلی/آزمایشی وردپرس بدون تایید دامنه روی production (پیش‌فرض خاموش)
# SANDBOX_DAILY_CAP=50     ← سقف روزانه‌ی اتصال‌های تایید‌نشده (Sandbox)

# ═════════ اعلان گفتگوی آنلاین به پیام‌رسان‌ها (بله/تلگرام/ایتا) ═════════
# CHAT_ALERT_ESCALATE_SECONDS=90   ← پشتیبانِ «آنلاین» اگر تا این مدت پیام مشتری را ندیده باشد، به پیام‌رسان خبر داده می‌شود (۵ تا ۳۶۰۰)
# CHAT_ALERT_THROTTLE_SECONDS=120  ← حداقل فاصله‌ی دو اعلان برای هر گفتگو؛ پیام‌های میانی در اعلان بعدی خلاصه می‌شوند (۰ تا ۳۶۰۰)
