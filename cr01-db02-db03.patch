+export async function withTransaction<T>(fn: (tx: Tx) => Promise<T>): Promise<T> {
+  const parent = activeScope();
+  const scope: TxScope = { tx: undefined as unknown as Tx, commitHooks: [], rollbackHooks: [], closed: false };
