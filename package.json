{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:qa": "tsx scripts/qa.ts",
    "qa": "tsx scripts/qa.ts",
    "qa:smoke": "tsx scripts/qa.ts --layers smoke",
    "qa:contract": "tsx scripts/qa.ts --layers contract",
    "qa:a11y": "tsx scripts/qa.ts --layers a11y",
    "qa:perf": "tsx scripts/qa.ts --layers perf-seo",
    "qa:lighthouse": "tsx scripts/qa.ts --layers lighthouse",
    "qa:visual": "tsx scripts/qa.ts --layers visual",
    "qa:visual:update": "tsx scripts/qa.ts --layers visual --update-visual",
    "qa:security": "tsx scripts/qa.ts --layers security",
    "qa:load": "tsx scripts/qa.ts --layers load",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "plugin:keygen": "tsx scripts/plugin-release.ts keygen",
    "plugin:sign": "tsx scripts/plugin-release.ts sign",
    "plugin:verify": "tsx scripts/plugin-release.ts verify",
    "plugin:verify:release": "tsx scripts/plugin-release.ts verify --release",
    "db:check": "node scripts/gen-schema-sql.mjs",
    "smoke": "node scripts/smoke.mjs",
    "simulator": "tsx simulator/cli.ts",
    "release": "node scripts/build-release.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "verify": "next typegen && tsc --noEmit --pretty false && next build",
    "infra:check": "node scripts/check-infra.mjs",
    "infra:selftest": "bash scripts/infra-selftest.sh"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "htmlparser2": "^9.1.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.2",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.2",
    "pg": "8.20.0",
    "pg-copy-streams": "^7.0.0",
    "playwright": "^1.65.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.18.2",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
